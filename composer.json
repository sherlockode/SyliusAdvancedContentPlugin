{
    "name": "sherlockode/sylius-advanced-content-plugin",
    "type": "sylius-plugin",
    "description": "Sylius plugin for SherlockodeAdvancedContentBundle",
    "keywords": [
        "sylius",
        "sylius-plugin"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sherlockode/advanced-content-bundle": "^0.10",
        "sylius/sylius": "^2.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/form": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "twig/twig": "^3.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-sylius-2": "1.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Sherlockode\\SyliusAdvancedContentPlugin\\": "src/"
        }
    }
}
